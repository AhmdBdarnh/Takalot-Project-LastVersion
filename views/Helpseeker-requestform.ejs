  <script>
    // Wait for the DOM to be fully loaded
    document.addEventListener("DOMContentLoaded", function(){
      console.log("Script loaded.");
    
      // Event listener for the image input field
      document.getElementById('image').addEventListener('change', function(event) {
        console.log(`Image upload triggered`);
        var file = event.target.files[0];
        var status = document.getElementById('classificationStatus');
        if (!file) {
          return;
        }
        status.textContent = 'Classifying image...';

        var formData = new FormData();
        formData.append('image', file);

        fetch('/api/upload-image', {
            method: 'POST',
            body: formData,
        })
        .then(async response => {
            const text = await response.text();
            if (!response.ok) {
                throw new Error(text || 'Image upload failed');
            }
            return text ? JSON.parse(text) : {};
        })
        .then(data => {
            const categoryLabels = {
              'pip': 'Pipe services',
              'power socket': 'Power socket services',
              'door handlers': 'Door handle repair'
            };
            const normalizedCategory = {
              'handel_door': 'door handlers',
              'power_socket': 'power socket',
              'pip': 'pip'
            }[data.category] || data.category;

            if (!normalizedCategory) {
              status.textContent = 'Could not identify a category. Please choose one manually.';
              return;
            }

            const userConfirmed = confirm(`The system suggests "${categoryLabels[normalizedCategory] || normalizedCategory}". Use this category or choose another?`);
            var select = document.getElementById('category');
            select.innerHTML = ''; // Clear existing options before adding new ones

            if (userConfirmed) {
                var option = document.createElement('option');
                option.value = normalizedCategory;
                option.textContent = categoryLabels[normalizedCategory] || normalizedCategory;
                option.selected = true;
                select.appendChild(option);
                status.textContent = `Suggested category: ${normalizedCategory}`;
            } else {
                var placeholderOption = document.createElement('option');
                placeholderOption.value = '';
                placeholderOption.textContent = 'Please select a category...';
                select.appendChild(placeholderOption);

                var categories = ["pip", "power socket", "door handlers"];
                categories.forEach(function(category) {
                    var option = document.createElement('option');
                    option.value = category;
                    option.textContent = categoryLabels[category] || category;
                    select.appendChild(option);
                });
                status.textContent = 'Choose the category that best describes the issue.';
            }
        })
        .catch(error => {
          console.error('Image classification error:', error);
          status.textContent = 'Image classification is unavailable. Choose a category manually.';
        });
      });
    });
  </script>
    



  <!-- Vendor JS Files -->
