    <section class="section" style="width: 90%;">
      <div class="row" style="width: 100%;">
        <div class="col-lg-6">

          <div class="card">
            <div class="card-body">
              <h5 class="card-title"><%= typeof requestData !== 'undefined' && requestData ? 'Update request' : 'New service request' %></h5>

              <!-- General Form Elements -->
              <form id="MainForm" action="/home/request" method="POST" enctype="multipart/form-data">

                <% if (typeof requestID !== 'undefined' && requestID !== null) { %>
                  <input type="hidden" name="req_id" value="<%= requestID %>">
                <% } %>


                <div class="row mb-3">
                  <div class="form-group">
                    <label for="image">Upload a Picture:</label>
                    <input type="file" id="image" name="image" accept="image/*">
                    <p id="classificationStatus" class="form-text" role="status"></p>
                  </div>
                </div>
            
                <div class="row mb-3">
                  <label for="category">Category:</label>
                  <select id="category" name="category" data-selected-category="<%= (typeof requestData !== 'undefined' && requestData ? requestData.category : '') || (typeof selectedCategory !== 'undefined' ? selectedCategory : '') %>" required></select>
                </div>
            
                <div class="row mb-3">
                  <label for="details">Add Details:</label>
                    <textarea id="details" name="details" placeholder="Enter your details here" required><%= typeof requestData !== 'undefined' && requestData ? requestData.details : '' %></textarea>
                </div>
            
                <div class="row mb-3">
                    <div class="col-sm-9 offset-sm-3">
                        <button id="submitRequest" type="submit" class="btn btn-primary"><%= typeof requestData !== 'undefined' && requestData ? 'Save changes' : 'Create request' %></button>
                    </div>
                </div>
            </form><!-- End General Form Elements -->
            </div>
