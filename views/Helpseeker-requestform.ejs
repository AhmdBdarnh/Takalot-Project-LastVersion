<script>
  var jsonData = {
      "categories": ["pip", "power socket", "door handlers"]
  };
    var categoryLabels = {
      "pip": "Pipe services",
      "power socket": "Power socket services",
      "door handlers": "Door handle repair"
    };
  function populateCategories() {
      var select = document.getElementById("category");
      var placeholder = document.createElement("option");
      placeholder.textContent = "Choose a category";
      placeholder.value = "";
      placeholder.disabled = true;
        placeholder.selected = !select.dataset.selectedCategory;
      select.appendChild(placeholder);
      jsonData.categories.forEach(function(category) {
          var option = document.createElement("option");
          option.textContent = categoryLabels[category] || category;
          option.value = category;
          option.selected = category === select.dataset.selectedCategory;
          select.appendChild(option);
      });
  }
  populateCategories();
</script>
