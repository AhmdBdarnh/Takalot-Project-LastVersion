<body>

  <header id="header" class="header fixed-top d-flex align-items-center">
    <div class="d-flex align-items-center justify-content-between">
      <a href="/home/technical" class="logo d-flex align-items-center">
        <img src="/img/logo2.png" alt="" alt="" width="45" height="100">
        <span class="d-none d-lg-block">Takalot</span>
      </a>
      <i class="bi bi-list toggle-sidebar-btn"></i>
    </div><!-- End Logo -->

    <div class="search-bar">
      <form class="search-form d-flex align-items-center" method="get" action="#">
        <input type="text" name="query" placeholder="Search" title="Enter search keyword">
        <button type="submit" title="Search"><i class="bi bi-search"></i></button>
      </form>
    </div><!-- End Search Bar -->

    <nav class="header-nav ms-auto">
      <ul class="d-flex align-items-center">



        <li class="nav-item dropdown">

          <a class="nav-link nav-icon" href="#" data-bs-toggle="dropdown">
            <i class="bi bi-bell"></i>
            <span class="badge bg-primary badge-number"></span>
          </a><!-- End Notification Icon -->

          <ul id="notifications" class="dropdown-menu dropdown-menu-end dropdown-menu-arrow notifications">
            
          
          </ul><!-- End Notification Dropdown Items -->

        </li><!-- End Notification Nav -->

        <li class="nav-item dropdown pe-3">

          <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
            <img src="/img/messages-3.jpg" alt="Profile" class="rounded-circle"> 
            <span class="d-none d-md-block dropdown-toggle ps-2"></span>
          </a><!-- End Profile Iamge Icon -->

          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">

            <li>
              <a class="dropdown-item d-flex align-items-center" href="/logout?role=technical">
                <i class="bi bi-box-arrow-right"></i>
                <span>Sign Out</span>
              </a>
            </li>

          </ul><!-- End Profile Dropdown Items -->
        </li><!-- End Profile Nav -->

      </ul>
    </nav><!-- End Icons Navigation -->

  </header><!-- End Header -->





  <!-- ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// -->
  <aside id="sidebar" class="sidebar">

    <ul class="sidebar-nav" id="sidebar-nav">

      <li class="nav-item">
        <a class="nav-link " href="/home/technical">
          <i class="bi bi-grid"></i>
          <span>Home Page</span>
        </a>
      </li>

      <li class="nav-item">
        <a class="nav-link " href="/techhome/request">
          <i class="bi bi-grid"></i>
          <span>Request</span>
        </a>
      </li>

      <li class="nav-item">
        <a class="nav-link " href="/tech/offers">
          <i class="bi bi-grid"></i>
          <span>Offers</span>
        </a>
      </li>

   

  </aside><!-- End Sidebar-->



<!-- main -->

<main id="main" class="main">
  <div class="pagetitle">
      <h1>Requests</h1>
      <nav>
          <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/home/technical">Home</a></li>
              <li class="breadcrumb-item active">Requests</li>
          </ol>
      </nav>
  </div><!-- End Page Title -->

  <section class="py-5">
      <div class="container">
          <div class="row justify-content-center">
              <% if (requests.length > 0) { %>

                  <% requests.forEach(request => { %>
                      <div class="col-md-6 col-lg-4 d-flex align-items-stretch mb-4">
                          <!-- Profile Card -->
                          <div class="card h-100">
                              <% if (request.image && request.image.image && request.image.contentType) { %>
                                <img class="request-image" src="data:<%= request.image.contentType %>;base64,<%= request.image.image.toString('base64') %>" alt="Uploaded issue">
                              <% } else { %>
                                <div class="request-image image-placeholder"><i class="bi bi-image" aria-hidden="true"></i><span>No photo attached</span></div>
                              <% } %>
                              <div class="card-body d-flex flex-column">
                                  <!-- Homeowner's Name -->
                                  <% const helpseeker = helpseekers.find(helpseeker => helpseeker && helpseeker.id === request.helpseekerId); %>
                                  <h5 class="card-title">Homeowner: <%= helpseeker ? helpseeker.fullName : 'Help seeker' %></h5>
                                  <!-- Phone Number -->
                                  <p class="card-text"><strong>Phone:</strong> <%= helpseeker ? helpseeker.phoneNumber : 'Not available' %></p>
                                  <!-- Details about a Malfunction -->
                                  <p class="card-text"><strong>Details about the malfunction:</strong> <%= request.details %></p>
                                  <!-- Action Buttons -->
                                  <div class="mt-auto d-flex justify-content-between request-actions">
                                    <form action="/tech/deleteOffer" method="post">
                                       <input type="hidden" name="ignoreID" value="<%= request._id %>">
                                        <button class="btn btn-outline-secondary" type="submit">Ignore</button>
                                    </form>
                                      <!-- Trigger Modal Button for Adding Offer or Assistance -->
                                      <details class="offer-composer">
                                        <summary class="btn btn-primary">Add offer</summary>
                                        <form action="/tech/addOffer" method="post" class="offer-composer-form">
                                          <input type="hidden" name="requestID" value="<%= request._id %>">
                                          <label for="bid-<%= request._id %>" class="form-label">Your bid</label>
                                          <input type="number" class="form-control" id="bid-<%= request._id %>" name="bid" min="1" step="0.01" placeholder="Enter amount" required>
                                          <label for="comments-<%= request._id %>" class="form-label">Message</label>
                                          <textarea class="form-control" id="comments-<%= request._id %>" name="comments" rows="3" placeholder="Describe your offer"></textarea>
                                          <button class="btn btn-primary" type="submit">Send offer</button>
                                        </form>
                                      </details>
                                  </div>
                              </div>
                          </div>
                      </div>
                                                         
                  <% }) %>
              <% } else { %>
                  <div class="col-12">
                      <p>No requests available at the moment.</p>
                  </div>
              <% } %>
          </div>
      </div>
  </section>
</main>



<script>
</script>

<script>
  const technicianSocket = io(`/?userId=<%= technicalID %>`);
  technicianSocket.on("newRequest", (notification) => {
    const notice = document.createElement("div");
    notice.className = "alert alert-info";
    notice.setAttribute("role", "status");
    notice.textContent = `${notification.title}: ${notification.message}`;
    document.querySelector("#main").prepend(notice);
  });
</script>







<script>
  // Get the search input element
  const searchInput = document.querySelector('input[name="query"]');

  // Reset the value of the search input field
  searchInput.value = '';
</script>


  <style>
